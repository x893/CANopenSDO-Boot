                "${workspaceFolder}/at32_fwlib/libraries/cmsis/cm4/device_support",
                "${workspaceFolder}/at32_fwlib/libraries/cmsis/cm4/core_support",
                "${workspaceFolder}/at32_fwlib/libraries/drivers/inc"
